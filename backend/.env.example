HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
MAX_BODY_BYTES=16384
BODY_TIMEOUT_MS=10000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Optional absolute directory containing screening.json, biomarker.json,
# report.json and sources.json. Defaults to the existing frontend/data exports.
# MODEL_DATA_DIR=/absolute/path/to/exported/data

# Optional saved assessments. Set BOTH after applying the Supabase SQL migration.
# Copy the project URL and publishable key from Supabase's Connect/API Keys panels.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_MS=10000

# Optional Gemini explanation support. Keep this key server-side and never put it in frontend code.
# The deterministic kidney-health explanation is used automatically when this is unset,
# rate-limited, times out, or Gemini returns an invalid response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
